// Tenant DB — una por cliente. Contiene los datos operacionales del tenant:
// conexiones a marketplaces (con credenciales cifradas), pedidos, items,
// eventos de webhook y audit log local.
//
// Esta schema se aplica a la DB recien creada en el flujo de provisioning
// (apps/api/src/modules/tenants/provisioning.service.ts).

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/tenant-client"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

// Sede / bodega / almacen. Nombre personalizable por el tenant.
model Warehouse {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  archived  Boolean  @default(false)
  // Prefijo de facturacion para VTEX (ej. Pasto = "PA"). Se antepone al numero de
  // factura de Alegra al facturar en VTEX -> invoiceNumber = "PA" + nroAlegra.
  invoicePrefix String?
  // Plantilla del Certificado de Garantia: overlay (cajas de tapar + textos) que
  // se aplica sobre la factura de Alegra con pdf-lib. JSON editable visualmente.
  // null/vacio = se envia la factura cruda (sin transformar).
  certificateTemplate Json?
  // Paquetes predefinidos para guias de Coordinadora: [{name, weight, height,
  // width, length}]. Como los "empaques" del portal de Coordinadora (su API no
  // los expone), pero configurados por sede aqui.
  packagePresets Json?
  // CLIENTE FIJO de Alegra: si esta puesto, TODAS las facturas de esta sede se
  // emiten en Alegra a este contacto ({id, name, identification}), en vez de al
  // comprador. Ojo: el documento que se le manda al comprador por el chat sigue
  // llevando SU nombre — eso lo resuelve la plantilla del certificado.
  alegraFixedClient Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  members      WarehouseMember[]
  alegra       AlegraConnection?
  coordinadora CoordinadoraConnection?
  sellerPrefs  AlegraSellerPref[]

  @@index([archived])
}

// Conexion a la transportadora (Coordinadora) de una sede. 1:1 con Warehouse:
// cada sede genera guias con su cuenta + su ORIGEN (remitente) propio. Auth de
// Coordinadora = usuario + SHA256(password); guardamos el password CIFRADO con la
// DEK del tenant (envelope) y calculamos el SHA256 al llamar. Ademas guarda el
// origen (remitente) de la sede, obligatorio para generar guia. (Mirror del patron
// AlegraConnection.)
model CoordinadoraConnection {
  id                String @id @default(cuid())
  warehouseId       String @unique
  idCliente         Int
  usuario           String
  encryptedPassword Bytes
  nit               String
  div               String @default("01")
  // Formato del rotulo (id_rotulo de Coordinadora). 55 = 10x10 cm con cajas.
  rotuloId          Int    @default(55)

  // Origen / remitente de esta sede (se pre-llena al generar la guia; editable).
  senderName     String
  senderNit      String?
  senderPhone    String
  senderAddress  String
  senderCityCode String // codigo DANE de 8 digitos
  senderCityName String?
  // CP del ORIGEN de la sede (Skydropx cotiza por codigo postal).
  senderPostalCode String?

  status    String   @default("connected")
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

// Conexion al sistema contable (Alegra) de una sede. 1:1 con Warehouse: cada
// bodega factura con su propia cuenta de Alegra. El API token va cifrado con la
// DEK del tenant (envelope), nunca en claro. (Mirror del patron MarketplaceConnection.)
model AlegraConnection {
  id             String   @id @default(cuid())
  warehouseId    String   @unique
  email          String
  encryptedToken Bytes
  companyName    String?
  status         String   @default("connected")
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

/// Alerta de SUPER MENCION (@todos): UNA fila por destinatario. Se muestra
/// como modal al que esta en la plataforma y, si no estaba, apenas vuelve
/// (seenAt = null hasta que la cierre o vaya al pedido).
model SuperMentionAlert {
  id         String    @id @default(cuid())
  orderId    String
  messageId  String
  userId     String
  authorName String
  preview    String
  createdAt  DateTime  @default(now())
  seenAt     DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, seenAt])
}

/// Reaccion de un usuario a un PEDIDO (como las de los mensajes del chat,
/// pero a nivel de fila). Cualquiera puede reaccionar; un emoji por usuario.
model OrderReaction {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  userName  String
  emoji     String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, userId, emoji])
  @@index([orderId])
}

/// Ajustes generales del workspace (clave -> JSON). Hoy: 'packagePresets'
/// (paquetes de guia GLOBALES, ya no por sede).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Vendedor de Alegra elegido por CADA usuario en una sede: las facturas que ese
/// usuario emita desde esa sede salen con ese "seller" de Alegra. El catalogo de
/// vendedores se trae en vivo de Alegra (no se espeja).
model AlegraSellerPref {
  id          String   @id @default(cuid())
  warehouseId String
  userId      String
  sellerId    String
  sellerName  String
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, userId])
}

// Que usuarios (operadores) pertenecen a que sede. userId referencia al User del
// control plane (referencia por convencion, distinta DB). Usado para el scoping:
// un operador solo ve los pedidos de sus sedes. (Se explota cuando exista el
// flujo de invitaciones de usuarios.)
model WarehouseMember {
  id          String   @id @default(cuid())
  warehouseId String
  userId      String
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, userId])
  @@index([userId])
}

// Conexion a un proveedor de IA con vision (OpenAI / Gemini / Anthropic) a nivel
// tenant. Una sola por tenant (el modelo a utilizar). Se usa para extraer el IMEI
// de la foto. La API key va cifrada con la DEK del tenant (envelope).
// Historial de WhatsApp (se guarda AQUI todo lo que pasa por el numero —
// salientes al enviarlos desde la plataforma, entrantes via webhook Cloud API).
// El hilo se arma por TELEFONO (10 digitos CO): un cliente comparte hilo entre
// sus pedidos.
model WaMessage {
  id            String   @id @default(cuid())
  phone         String // ultimos 10 digitos (normalizado CO)
  direction     String // in | out
  kind          String   @default("text") // text | image | video | audio | file
  body          String?
  // Medio: key de nuestro storage (salientes; la URL se firma al vuelo) o URL
  // externa tal cual llego del webhook (entrantes).
  attachmentKey String?
  mediaUrl      String?
  authorId      String? // usuario de la plataforma que lo envio (salientes)
  authorName    String?
  contactId     String? // legado (id de contacto del proveedor anterior) / stash "media:<id>"
  // Botones del mensaje (titulos, solo para PINTARLOS en el hilo como en el cel).
  buttons       Json?
  // Cita (responder deslizando): id del WaMessage citado.
  replyToId     String?
  // Reacciones sobre el mensaje: [{ emoji, mine }] (mine = del negocio).
  reactions     Json?
  // Chulitos de salientes: sent | delivered | read | failed.
  status        String?
  // Detalle del FALLO de entrega (Meta) — se muestra al tocar la bolita roja.
  error         String?
  // EDITADO desde el celular (se muestra "Editado" junto a la hora).
  edited        Boolean  @default(false)
  // Destacado (estrella), como en WhatsApp.
  starred       Boolean  @default(false)
  // Id del mensaje en WhatsApp (wamid de la Cloud API): dedup de reentregas.
  // NO se le agrega la linea: los wamid de Meta son unicos globalmente y
  // meterla debilitaria el dedup de reentregas.
  externalId    String?  @unique
  // Por que LINEA salio o entro. null = mensajes anteriores a las lineas.
  lineId        String?
  createdAt     DateTime @default(now())

  @@index([phone, createdAt])
  @@index([lineId, createdAt])
}

/// LINEA de WhatsApp: un numero conectado. Antes se llamaba
/// Dialog360Connection y era un singleton forzado (el servicio hacia
/// deleteMany antes de crear); ahora pueden convivir varias, cada una con su
/// proveedor, sus credenciales y sus flujos.
///
/// El CUERPO de los mensajes es Cloud API de Meta en los dos proveedores: lo
/// unico que cambia es la URL base, la cabecera de auth y como se verifica el
/// webhook. Por eso el cliente HTTP se reusa entero.
model WaLine {
  id     String @id @default(cuid())
  /// Nombre visible ("Ventas", "Soporte"). Es lo que distingue una linea de
  /// otra en la interfaz.
  label  String
  /// 'dialog360' (BSP) | 'meta' (Cloud API nativa).
  provider String @default("dialog360")
  /// Numero en E.164 tal como lo reporta el proveedor (+573001234567).
  phone  String?
  /// Prefijo de pais para normalizar telefonos de esta linea (Colombia = 57).
  countryCode String @default("57")

  // --- Credenciales (cifradas con la DEK del tenant) ---
  /// 360dialog: la D360-API-KEY. Meta: el token permanente de la App.
  encryptedApiKey Bytes
  /// Solo Meta: secreto de la App, para validar la firma del webhook.
  encryptedAppSecret Bytes?
  /// Solo Meta: id del numero y de la WABA (van en la URL de la Cloud API).
  phoneNumberId String?
  wabaId        String?
  /// Solo Meta: token del challenge GET del webhook. No es secreto.
  verifyToken   String?

  mode       String   @default("production") // sandbox | production
  webhookUrl String?
  /// La linea que se usa cuando ninguna regla dice otra cosa.
  isDefault  Boolean  @default(false)
  status     String   @default("connected")
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  flows WaFlow[]

  @@index([status])
}

/// MENSAJE AUTOMATICO configurable. Los cuatro `kind` son fijos porque cada uno
/// tiene guardas propias en codigo (frescura, idempotencia, maquina de estados);
/// lo que es DATO es si esta encendido, por que linea sale, a que tiendas
/// aplica y sus textos.
///
/// Si NO existe ninguna fila de un kind, ese flujo se comporta exactamente como
/// antes (defaults de codigo). En cuanto existe una, manda la tabla.
model WaFlow {
  id      String  @id @default(cuid())
  /// confirmation | guide | upsell | autoreply
  kind    String
  lineId  String
  enabled Boolean @default(true)
  /// Fuentes a las que aplica: ["*"] = todas, o ["vtex:tienda-a", "manual:krediya"].
  scope   Json    @default("[\"*\"]")
  /// Ajustes propios del kind (textos, tiempos, orden de plantillas).
  config  Json    @default("{}")
  /// Desempate cuando dos reglas encajan (mayor gana). El alcance exacto
  /// siempre gana sobre "*", pase lo que pase con la prioridad.
  priority Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  line WaLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([kind, enabled])
  @@index([lineId])
}

// Contacto de WhatsApp por telefono (nombre + estado del flujo de confirmacion).
model WaContact {
  phone        String   @id
  contactId    String
  name         String?
  // Etiquetas del chat (bandeja): ["Cliente", "Garantia", ...] — globales.
  labels       Json?
  // Operaciones de la bandeja (menu contextual), globales del negocio.
  archived     Boolean  @default(false)
  muted        Boolean  @default(false)
  pinned       Boolean  @default(false)
  // Estado del flujo de confirmacion NATIVO (Cloud API): esperando direccion,
  // confirmando el borrador, etc. draftAddress = la direccion que escribio.
  flowState    String?
  draftAddress String?
  updatedAt    DateTime @updatedAt
}

// Etiquetas de la bandeja de WhatsApp, con su COLOR (registro global).
model WaLabel {
  name  String @id
  color String @default("#00a884")
}

// Stickers FAVORITOS del negocio (compartidos): apuntan a nuestro storage.
model WaStickerFav {
  id            String   @id @default(cuid())
  attachmentKey String   @unique
  createdAt     DateTime @default(now())
}

// Marcador de lectura de la BANDEJA de WhatsApp: por usuario y telefono.
// unread = mensajes entrantes posteriores a lastReadAt (contador verde).
model WaChatRead {
  userId     String
  phone      String
  lastReadAt DateTime @default(now())

  @@id([userId, phone])
}

// Remitente SKYDROPX por sede (separado de Coordinadora): cada sede fija UNA
// direccion de origen guardada/VERIFICADA del panel de Skydropx — las
// paqueterias como Inter exigen origen verificado (address_template_id).
model SkydropxSedeConfig {
  warehouseId       String   @id
  addressTemplateId String
  // Snapshot para pintar sin llamar a Skydropx (alias/ciudad/CP de la plantilla).
  alias             String?
  city              String?
  postalCode        String?
  updatedAt         DateTime @default(now()) @updatedAt
}

// Conexion a SKYDROPX (agregador multi-transportadora; segunda opcion de guia
// junto a Coordinadora). UNA por tenant; OAuth client_credentials cifrado.
model SkydropxConnection {
  id                 String   @id @default(cuid())
  encryptedApiKey    Bytes
  encryptedApiSecret Bytes
  mode               String   @default("sandbox") // sandbox | production
  status             String   @default("connected")
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

model AiConnection {
  id              String   @id @default(cuid())
  provider        String // openai | gemini | anthropic
  model           String
  encryptedApiKey Bytes
  status          String   @default("connected")
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Indice local IMEI -> factura de compra de Alegra. Alegra no permite buscar por
// IMEI (vive en texto libre de la observacion de la linea), asi que espejamos las
// facturas de compra y parseamos los IMEI aca para poder buscar O(1). imei unico
// por tenant (cada equipo fisico es unico).
model AlegraImeiIndex {
  id                String    @id @default(cuid())
  imei              String    @unique
  billId            String
  billNumber        String?
  billDate          DateTime?
  providerName      String?
  itemName          String?
  unitCost          Decimal?  @db.Decimal(14, 2)
  sourceWarehouseId String
  observations      String?
  syncedAt          DateTime  @default(now())

  @@index([sourceWarehouseId])
  @@index([billId])
}

model MarketplaceConnection {
  id                String    @id @default(cuid())
  provider          String
  accountName       String
  // Nombre visible de la tienda. Con dos VTEX conectados es lo unico que las
  // distingue en las pestañas de pedidos. null = se muestra el accountName.
  label             String?
  // Blobs auto-contenidos: cada uno embebe [iv:12][tag:16][ciphertext:N].
  // Una sola columna por campo cifrado = imposible mezclar iv/tag entre campos.
  encryptedAppKey   Bytes
  encryptedAppToken Bytes
  webhookSecret     String
  status            String    @default("connected")
  lastSyncedAt      DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([provider, accountName])
  @@index([provider, status])
}

model Order {
  id                   String   @id @default(cuid())
  externalId           String
  provider             String
  accountName          String
  customerName         String
  customerEmail        String?
  customerDocument     String?
  customerPhone        String?
  status               String
  totalValue           Decimal  @db.Decimal(14, 2)
  currency             String   @default("COP")
  // Denormalizado: suma de quantity de los items. Permite ordenar por
  // "cantidad" en el server (con paginacion) sin un join+sum por pagina.
  totalUnits           Int      @default(0)
  // Producto "cabeza" del pedido: el PRIMERO alfabeticamente de sus items.
  // Denormalizado igual que guideNumber/shippingState, y por la misma razon:
  // los items viven en otra tabla y Prisma no sabe ordenar el padre por un
  // campo de una relacion 1:N. Con esto "ordenar por producto" agrupa los
  // pedidos del mismo articulo y sigue paginando bien.
  primaryProduct       String?
  // Asignacion a sede. null = "pedidos generales" (espejo automatico de VTEX).
  // Cuando se asigna a una sede, el pedido queda "reclamado": pasa a tener ciclo
  // propio y el reconcile NO lo borra aunque cambie de estado en VTEX.
  warehouseId          String?
  assignedAt           DateTime?
  // Envio: denormalizado para poder listar/filtrar sin llamar a Coordinadora por fila.
  // guideNumber se copia del evento 'guide_generated'; el resto lo refresca el rastreo.
  guideNumber          String?
  shippingState        String? // sin_movimientos | en_transito | novedad | entregado
  shippingStatus       String? // descripcion cruda de la transportadora
  shippingUpdatedAt    DateTime?
  // Como salio el envio: 'coordinadora' (null = legado) | 'skydropx' |
  // 'domicilio' (transportadora propia: sin guia, sin rastreo y sin link — por
  // eso en domicilio guideNumber se queda NULL, que es lo que lo mantiene
  // fuera del poll de rastreo).
  shippingProvider     String?
  // Id del shipment en Skydropx (para el rastreo por API).
  skydropxShipmentId   String?

  // Confirmacion de direccion por WhatsApp: el cliente confirma o
  // modifica su direccion desde el mensaje de confirmacion del pedido.
  addressStatus        String? // null=sin responder | confirmed | modified
  confirmedAddress     String? // texto de la nueva direccion cuando modified
  addressConfirmedAt   DateTime?

  // "Tomar pedido": quien lo tomo queda a cargo (nadie mas puede tomarlo).
  // Nombre denormalizado para pintar la ficha sin joins.
  claimedById          String?
  claimedByName        String?
  claimedAt            DateTime?

  marketplaceCreatedAt DateTime
  receivedAt           DateTime @default(now())
  updatedAt            DateTime @updatedAt
  rawPayload           Json

  items         OrderItem[]
  messages      OrderMessage[]
  events        OrderEvent[]
  reads         OrderRead[]
  reactions     OrderReaction[]
  superMentions SuperMentionAlert[]
  warehouse     Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  // La CUENTA entra en la clave: el orderId de VTEX solo es unico dentro de una
  // tienda, asi que con dos cuentas conectadas el pedido de la segunda pisaba
  // al de la primera (mismo id -> el upsert lo tomaba por el mismo pedido).
  @@unique([provider, accountName, externalId])
  @@index([status, marketplaceCreatedAt(sort: Desc)])
  @@index([status, totalUnits])
  @@index([status, totalValue])
  @@index([provider, status])
  @@index([warehouseId, status])
  @@index([warehouseId, shippingState])
  @@index([receivedAt(sort: Desc)])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  sku       String
  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(14, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Conversacion por pedido (el "chat" que se abre en el drawer de la sede).
// Mensajes de texto y, mas adelante, la Foto IMEI como adjunto (kind='imei_photo').
model OrderMessage {
  id             String   @id @default(cuid())
  orderId        String
  authorId       String
  authorName     String
  kind           String   @default("text") // text | imei_photo | system
  body           String?
  // Adjunto (foto IMEI / documentos). Nullable hasta que exista storage (R2/S3).
  attachmentKey  String?
  attachmentUrl  String?
  attachmentMime String?
  // Texto que acompaña a un adjunto (estilo WhatsApp): viaja EN el mismo
  // mensaje que la imagen/video/archivo, no como mensaje aparte.
  caption        String?
  // IMEIs extraidos del adjunto cuando kind='imei_photo' (flujo Foto IMEI, siguiente fase).
  imeis          String[]
  // userIds mencionados en el mensaje (@usuario) -> alimenta notificaciones.
  mentions       String[]
  // Respuesta/cita: id del mensaje citado (mismo pedido). El front lo resuelve
  // contra la lista cargada; si el original se borro, muestra "eliminado".
  replyToId      String?
  createdAt      DateTime @default(now())

  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]

  @@index([orderId, createdAt])
}

/// Reaccion con emoji a un mensaje del chat (una por usuario+emoji+mensaje).
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  userName  String
  emoji     String
  createdAt DateTime @default(now())

  message OrderMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// Estado de lectura del chat de un pedido por usuario: hasta cuando ley el hilo.
// Los "no leidos" = mensajes de otros creados despues de `lastReadAt`.
model OrderRead {
  id         String   @id @default(cuid())
  orderId    String
  userId     String
  lastReadAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, userId])
  @@index([userId])
}

// Linea de tiempo de actividad de un pedido (asignado / transferido / devuelto /
// cambio de estado). Alimenta la pestaña "Actividad" del drawer.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String // created | assigned | transferred | returned | status_changed
  actorId   String?
  actorName String?
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  signature   String?
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, eventId])
  @@index([status, receivedAt])
}

/// Cada respuesta del cliente al flujo de confirmacion de direccion.
/// Fuente de verdad para diagnosticar: si el cliente confirmo en WhatsApp y
/// no hay fila aqui, la respuesta nunca llego a la plataforma.
model ConfirmationLog {
  id        String   @id @default(cuid())
  phone     String
  action    String
  address   String?
  matched   Int      @default(0)
  note      String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?
  action    String
  resource  String?
  metadata  Json
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
